<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="2.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
  exclude-result-prefixes="sitemap">

  <xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>

  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="robots" content="noindex, nofollow"/>
        <title>Sitemap Index — CostumesPlanet.com</title>
        <style>
          *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
          body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f8f9fa; color: #1a1a2e; }
          header { background: #1a237e; color: #fff; padding: 1.5rem 2rem; }
          header h1 { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.02em; }
          header p  { font-size: 0.85rem; opacity: 0.75; margin-top: 0.25rem; }
          .container { max-width: 860px; margin: 2rem auto; padding: 0 1.5rem; }
          .badge { display: inline-block; background: #e8eaf6; color: #1a237e; border-radius: 999px; font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.7rem; margin-bottom: 1rem; }
          table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
          thead { background: #1a237e; color: #fff; }
          th { padding: 0.85rem 1.2rem; text-align: left; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
          td { padding: 0.8rem 1.2rem; font-size: 0.88rem; border-bottom: 1px solid #f0f0f5; }
          tr:last-child td { border-bottom: none; }
          tr:hover td { background: #f5f5ff; }
          a { color: #1a237e; text-decoration: none; }
          a:hover { text-decoration: underline; }
          .lastmod { color: #666; font-size: 0.82rem; }
          footer { text-align: center; color: #999; font-size: 0.78rem; margin: 2rem 0 3rem; }
        </style>
      </head>
      <body>
        <header>
          <h1>CostumesPlanet.com — Sitemap Index</h1>
          <p>Machine-readable sitemap for search engines · <a href="https://costumesplanet.com/" style="color:#c5cae9">← Back to site</a></p>
        </header>
        <div class="container">
          <span class="badge"><xsl:value-of select="count(sitemap:sitemapindex/sitemap:sitemap)"/> sitemaps</span>
          <table>
            <thead>
              <tr>
                <th>Sitemap</th>
                <th>Last Modified</th>
              </tr>
            </thead>
            <tbody>
              <xsl:for-each select="sitemap:sitemapindex/sitemap:sitemap">
                <tr>
                  <td><a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a></td>
                  <td class="lastmod"><xsl:value-of select="sitemap:lastmod"/></td>
                </tr>
              </xsl:for-each>
            </tbody>
          </table>
        </div>
        <footer>Generated by CostumesPlanet.com · XML sitemap for Googlebot</footer>
      </body>
    </html>
  </xsl:template>

</xsl:stylesheet>
