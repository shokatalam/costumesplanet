{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/spa-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/page/:n",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/game-of-thrones-costumes/:rest*",
      "destination": "/category/game-of-thrones/",
      "permanent": true
    },
    {
      "source": "/category/marvel-costumes/:rest*",
      "destination": "/category/marvel-dc/",
      "permanent": true
    },
    {
      "source": "/category/marvel/:rest*",
      "destination": "/category/marvel-dc/",
      "permanent": true
    },
    {
      "source": "/category/dc/:rest*",
      "destination": "/category/marvel-dc/",
      "permanent": true
    },
    {
      "source": "/category/star-wars-costumes/:rest*",
      "destination": "/category/star-wars/",
      "permanent": true
    },
    {
      "source": "/category/league-of-legends/:rest*",
      "destination": "/category/gaming/",
      "permanent": true
    },
    {
      "source": "/category/halloween/:rest*",
      "destination": "/category/pop-culture/",
      "permanent": true
    },
    {
      "source": "/category/Game%20of%20Thrones/:rest*",
      "destination": "/category/game-of-thrones/",
      "permanent": true
    },
    {
      "source": "/category/game-of-thrones/page/:n*",
